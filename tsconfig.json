{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "files": [
    "src/index.ts",
    "src/invariant.ts",
    "src/client/index.ts",
    "src/client/locales.ts",
    "src/client/slots.ts",
    "src/client/UpdaterPanel.tsx",
    "src/client/css-modules.d.ts"
  ]
}
