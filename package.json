{
  "name": "@deepseek-ai/dsh-client-ui-dsh-updater",
  "description": "DSH 版本检测与一键升级插件：自动检测最新版本，入口固定在设置上方。",
  "version": "0.2.0",
  "author": "msyrain (https://github.com/msyrain)",
  "homepage": "https://github.com/msyrain/ui-dsh-updater#readme",
  "bugs": {
    "url": "https://github.com/msyrain/ui-dsh-updater/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msyrain/ui-dsh-updater.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "deepseek",
    "updater",
    "desktop"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./invariant": "./lib/invariant.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh-updater-run.ps1",
    "install.mjs",
    "sync.mjs",
    "scripts/build.mjs",
    "scripts/package-files.mjs",
    "scripts/verify-bundle.mjs",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.mjs\"",
    "install:plugin": "node install.mjs",
    "uninstall:plugin": "node install.mjs --uninstall",
    "sync": "node sync.mjs",
    "sync:check": "node sync.mjs --check"
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-connection": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-invariants": "^0.1.6-alpha.2",
    "@types/node": "^26.0.0",
    "@types/react": "~18.3.1",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "rolldown": "^1.2.9",
    "typescript": "^6.0.3"
  }
}
